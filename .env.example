# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard → Connect). Never put the service_role/secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public address of the website, no trailing slash. Used for Google (sitemap,
# canonical links) and link previews. Change it when you move to your own domain.
VITE_SITE_URL=https://k-tech-mobile.shoplk.workers.dev
