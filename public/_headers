# Security headers served with every response from Cloudflare Workers.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Prevent the page from being loaded inside an iframe on another domain
  # (blocks clickjacking attacks).
  X-Frame-Options: DENY

  # Stop browsers from guessing a file's content type (blocks MIME-sniffing attacks).
  X-Content-Type-Options: nosniff

  # Force HTTPS for 1 year, including sub-domains.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent the URL from leaking via the Referer header to external sites.
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable access to sensitive browser APIs that this site never uses.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Content Security Policy — tightened for this SPA + Supabase backend.
  # Update the nonce/hash approach if you add inline scripts in the future.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
